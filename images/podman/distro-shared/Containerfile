ARG DISTRO_IMAGE

FROM ${DISTRO_IMAGE}

RUN set -eux; \
    . /etc/os-release; \
    case "${ID}" in \
        debian|ubuntu) \
            export DEBIAN_FRONTEND=noninteractive; \
            apt-get update; \
            apt-get --yes upgrade; \
            apt-get install --yes --no-install-recommends \
                ca-certificates \
                crun \
                fuse-overlayfs \
                iproute2 \
                iptables \
                podman \
                procps \
                slirp4netns \
                tar \
                uidmap; \
            rm -rf /var/lib/apt/lists/* \
            ;; \
        fedora|rhel|centos) \
            dnf --assumeyes --refresh upgrade; \
            dnf --assumeyes install --setopt=install_weak_deps=False \
                ca-certificates \
                crun \
                fuse-overlayfs \
                iproute \
                iptables \
                podman \
                procps-ng \
                shadow-utils \
                slirp4netns \
                tar; \
            dnf clean all; \
            rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey.log /var/log/yum.* \
            ;; \
        opensuse-leap|opensuse-tumbleweed) \
            zypper --non-interactive refresh; \
            if [ "${ID}" = "opensuse-tumbleweed" ]; then \
                zypper --non-interactive dist-upgrade --no-recommends; \
                oci_runtime=crun; \
            else \
                zypper --non-interactive update; \
                oci_runtime=runc; \
            fi; \
            zypper --non-interactive install --no-recommends \
                ca-certificates \
                fuse-overlayfs \
                iproute2 \
                iptables \
                podman \
                procps \
                shadow \
                slirp4netns \
                tar \
                "${oci_runtime}"; \
            zypper clean --all \
            ;; \
        alpine) \
            apk upgrade --no-cache; \
            apk add --no-cache \
                ca-certificates \
                crun \
                fuse-overlayfs \
                iproute2 \
                iptables \
                podman \
                procps \
                shadow \
                slirp4netns \
                tar \
            ;; \
        arch) \
            pacman --sync --refresh --sysupgrade --noconfirm; \
            pacman --sync --noconfirm --needed \
                ca-certificates \
                crun \
                fuse-overlayfs \
                iproute2 \
                iptables-nft \
                podman \
                procps-ng \
                shadow \
                slirp4netns \
                tar; \
            pacman --sync --clean --clean --noconfirm; \
            rm -rf /var/cache/pacman/pkg/* \
            ;; \
        *) \
            printf 'Unsupported distribution ID: %s\n' "${ID}" >&2; \
            exit 1 \
            ;; \
    esac; \
    mkdir -p /usr/share/strukturpiloten; \
    case "${ID}" in \
        debian|ubuntu) dpkg-query --show --showformat='${Version}\n' podman ;; \
        fedora|rhel|centos|opensuse-leap|opensuse-tumbleweed) \
            rpm --query --queryformat '%{VERSION}-%{RELEASE}.%{ARCH}\n' podman \
            ;; \
        alpine) apk info --exists --verbose podman ;; \
        arch) pacman --query podman | awk '{print $2}' ;; \
    esac > /usr/share/strukturpiloten/podman-package-version; \
    podman --version > /usr/share/strukturpiloten/podman-version; \
    if command -v crun; then :; else command -v runc; fi; \
    command -v fuse-overlayfs; \
    rm -f /etc/machine-id /var/lib/systemd/random-seed; \
    if ! grep -q '^podman:' /etc/group; then groupadd --gid 1000 podman; fi; \
    if ! grep -q '^podman:' /etc/passwd; then \
        useradd --uid 1000 --gid 1000 --create-home --home-dir /home/podman podman; \
    fi; \
    printf 'root:1:65535\npodman:1:999\npodman:1001:64535\n' > /etc/subuid; \
    printf 'root:1:65535\npodman:1:999\npodman:1001:64535\n' > /etc/subgid; \
    mkdir -p \
        /etc/containers \
        /var/lib/containers \
        /run/user/1000 \
        /home/podman/.config/containers \
        /home/podman/.local/share/containers; \
    chown -R podman:podman /run/user/1000 /home/podman; \
    chmod 0700 /run/user/1000; \
    if [ -x /usr/bin/newuidmap ]; then chmod u+s /usr/bin/newuidmap; fi; \
    if [ -x /usr/bin/newgidmap ]; then chmod u+s /usr/bin/newgidmap; fi

COPY images/podman/distro-shared/containers.conf /etc/containers/containers.conf
COPY images/podman/shared/storage.conf /etc/containers/storage.conf
COPY --chown=podman:podman images/podman/distro-shared/rootless-containers.conf /home/podman/.config/containers/containers.conf
COPY --chown=podman:podman images/podman/shared/rootless-storage.conf /home/podman/.config/containers/storage.conf

ARG OCI_BASE_DIGEST=""
ARG OCI_BASE_NAME=""
ARG OCI_CREATED=""
ARG OCI_DESCRIPTION="Distro-packaged Podman for compatibility testing"
ARG OCI_DOCUMENTATION=""
ARG OCI_LICENSES=""
ARG OCI_REVISION=""
ARG OCI_SOURCE=""
ARG OCI_TITLE="Podman compatibility image"
ARG OCI_URL=""
ARG OCI_VENDOR=""
ARG OCI_VERSION=""

LABEL org.opencontainers.image.base.digest="${OCI_BASE_DIGEST}" \
    org.opencontainers.image.base.name="${OCI_BASE_NAME}" \
    org.opencontainers.image.created="${OCI_CREATED}" \
    org.opencontainers.image.description="${OCI_DESCRIPTION}" \
    org.opencontainers.image.documentation="${OCI_DOCUMENTATION}" \
    org.opencontainers.image.licenses="${OCI_LICENSES}" \
    org.opencontainers.image.revision="${OCI_REVISION}" \
    org.opencontainers.image.source="${OCI_SOURCE}" \
    org.opencontainers.image.title="${OCI_TITLE}" \
    org.opencontainers.image.url="${OCI_URL}" \
    org.opencontainers.image.vendor="${OCI_VENDOR}" \
    org.opencontainers.image.version="${OCI_VERSION}"

ARG RUN_AS_USER
COPY images/podman/shared/mode-${RUN_AS_USER} /usr/share/containers/podman-mode

ARG HOME_DIR
ARG RUNTIME_DIR
ARG STORAGE_PATH

ENV BUILDAH_ISOLATION=chroot \
    HOME=${HOME_DIR} \
    XDG_RUNTIME_DIR=${RUNTIME_DIR} \
    _CONTAINERS_USERNS_CONFIGURED=""

VOLUME ${STORAGE_PATH}

USER ${RUN_AS_USER}

CMD ["podman", "--help"]
