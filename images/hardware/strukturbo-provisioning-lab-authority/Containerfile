ARG FEDORA_IMAGE
FROM ${FEDORA_IMAGE}
RUN dnf --assumeyes install --setopt=install_weak_deps=False ca-certificates unbound radvd python3 \
    && update-ca-trust && dnf clean all && rm -rf /var/cache/dnf /var/log/dnf* \
    && mkdir -p /usr/share/strukturbo /configuration /artifacts /leases /run/kea \
    && rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}.%{ARCH}\n' | sort > /usr/share/strukturbo/packages.txt
ARG OCI_REVISION=""
ARG OCI_VERSION=""
LABEL org.opencontainers.image.source="https://github.com/Strukturpiloten/containers" \
      org.opencontainers.image.revision="${OCI_REVISION}" \
      org.opencontainers.image.version="${OCI_VERSION}"
RUN unbound -V && python3 -c 'import re, subprocess; p = subprocess.run(["radvd", "--version"], capture_output=True, text=True); output = p.stdout + p.stderr; print(output, end=""); assert p.returncode in (0, 1) and re.search(r"^Version: [0-9]+\.[0-9]+", output, re.M)'
CMD ["/bin/bash"]
