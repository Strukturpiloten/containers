ARG BASE_IMAGE
ARG RUNTIME_IMAGE

FROM ${BASE_IMAGE} AS build

ARG OCI_BASE_DIGEST=""
ARG OCI_BASE_NAME=""
ARG OCI_CREATED=""
ARG OCI_DESCRIPTION="Nextcloud notify_push binary built from source with a minimal Alpine runtime"
ARG OCI_DOCUMENTATION=""
ARG OCI_LICENSES=""
ARG OCI_REVISION=""
ARG OCI_SOURCE=""
ARG OCI_TITLE="Nextcloud notify_push"
ARG OCI_URL=""
ARG OCI_VENDOR=""
ARG OCI_VERSION=""
ARG NOTIFYPUSH_REPOSITORY
ARG NOTIFYPUSH_VERSION
ARG NOTIFYPUSH_COMMIT
ARG SOURCE_DATE_EPOCH
ARG TARGETARCH

WORKDIR /notify_push

RUN set -eux; \
    apk update && \
    apk upgrade && \
    apk add --no-cache \
    git; \
    case "${TARGETARCH}" in \
    amd64) rust_target="x86_64-unknown-linux-musl" ;; \
    arm64) rust_target="aarch64-unknown-linux-musl" ;; \
    *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    rustup target add "${rust_target}"; \
    git clone --branch "${NOTIFYPUSH_VERSION}" "${NOTIFYPUSH_REPOSITORY}" .; \
    test "$(git rev-parse HEAD)" = "${NOTIFYPUSH_COMMIT}"; \
    test -f Cargo.lock; \
    cargo build --locked --release --target="${rust_target}"; \
    mkdir -p /usr/share/strukturpiloten; \
    { \
      printf 'notify_push_version=%s\n' "${NOTIFYPUSH_VERSION}"; \
      printf 'notify_push_commit=%s\n' "${NOTIFYPUSH_COMMIT}"; \
      printf 'cargo_lock_sha256=%s\n' "$(sha256sum Cargo.lock | cut -d ' ' -f 1)"; \
      printf 'rustc=%s\n' "$(rustc --version)"; \
      printf 'cargo=%s\n' "$(cargo --version)"; \
    } > /usr/share/strukturpiloten/application-components.txt; \
    apk info -v | sort > /usr/share/strukturpiloten/build-apk-packages.txt

FROM ${RUNTIME_IMAGE} AS final

ARG OCI_BASE_DIGEST=""
ARG OCI_BASE_NAME=""
ARG OCI_CREATED=""
ARG OCI_DESCRIPTION="Nextcloud notify_push binary built from source with a minimal Alpine runtime"
ARG OCI_DOCUMENTATION=""
ARG OCI_LICENSES=""
ARG OCI_REVISION=""
ARG OCI_SOURCE=""
ARG OCI_TITLE="Nextcloud notify_push"
ARG OCI_URL=""
ARG OCI_VENDOR=""
ARG OCI_VERSION=""

LABEL org.opencontainers.image.base.digest="${OCI_BASE_DIGEST}" \
    org.opencontainers.image.base.name="${OCI_BASE_NAME}" \
    org.opencontainers.image.created="${OCI_CREATED}" \
    org.opencontainers.image.description="${OCI_DESCRIPTION}" \
    org.opencontainers.image.documentation="${OCI_DOCUMENTATION}" \
    org.opencontainers.image.licenses="${OCI_LICENSES}" \
    org.opencontainers.image.revision="${OCI_REVISION}" \
    org.opencontainers.image.source="${OCI_SOURCE}" \
    org.opencontainers.image.title="${OCI_TITLE}" \
    org.opencontainers.image.url="${OCI_URL}" \
    org.opencontainers.image.vendor="${OCI_VENDOR}" \
    org.opencontainers.image.version="${OCI_VERSION}"

RUN set -eux; \
    mkdir -p /usr/share/strukturpiloten; \
    apk upgrade --no-cache; \
    apk info -v | sort > /usr/share/strukturpiloten/runtime-apk-packages.txt

COPY --from=build /notify_push/target/*/release/notify_push /usr/local/bin/notify_push
COPY --from=build /usr/share/strukturpiloten/application-components.txt /usr/share/strukturpiloten/application-components.txt
COPY --from=build /usr/share/strukturpiloten/build-apk-packages.txt /usr/share/strukturpiloten/build-apk-packages.txt

# Alpine guest user
USER 405

EXPOSE 7867

CMD ["/usr/local/bin/notify_push", "/nextcloud/config/config.php"]
