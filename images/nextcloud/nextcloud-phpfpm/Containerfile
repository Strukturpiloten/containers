ARG BASE_IMAGE
ARG PHP_EXTENSION_INSTALLER_IMAGE

FROM ${PHP_EXTENSION_INSTALLER_IMAGE} AS php-extension-installer
FROM ${BASE_IMAGE}

ARG OCI_BASE_DIGEST=""
ARG OCI_BASE_NAME=""
ARG OCI_CREATED=""
ARG OCI_DESCRIPTION="Nextcloud PHP-FPM runtime image with PHP extensions, ffmpeg and container utilities"
ARG OCI_DOCUMENTATION=""
ARG OCI_LICENSES=""
ARG OCI_REVISION=""
ARG OCI_SOURCE=""
ARG OCI_TITLE="Nextcloud PHP-FPM"
ARG OCI_URL=""
ARG OCI_VENDOR=""
ARG OCI_VERSION=""
ARG SOURCE_DATE_EPOCH
ARG PHP_EXTENSION_INSTALLER_IMAGE
ARG COMPOSER_VERSION
ARG PHP_APCU_VERSION
ARG PHP_IMAGICK_VERSION
ARG PHP_REDIS_VERSION
LABEL org.opencontainers.image.base.digest="${OCI_BASE_DIGEST}" \
    org.opencontainers.image.base.name="${OCI_BASE_NAME}" \
    org.opencontainers.image.created="${OCI_CREATED}" \
    org.opencontainers.image.description="${OCI_DESCRIPTION}" \
    org.opencontainers.image.documentation="${OCI_DOCUMENTATION}" \
    org.opencontainers.image.licenses="${OCI_LICENSES}" \
    org.opencontainers.image.revision="${OCI_REVISION}" \
    org.opencontainers.image.source="${OCI_SOURCE}" \
    org.opencontainers.image.title="${OCI_TITLE}" \
    org.opencontainers.image.url="${OCI_URL}" \
    org.opencontainers.image.vendor="${OCI_VENDOR}" \
    org.opencontainers.image.version="${OCI_VERSION}"

COPY --from=php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/install-php-extensions

RUN set -eux; \
    apk upgrade --no-cache && \
    apk add --no-cache \
    ca-certificates \
    ffmpeg \
    ffmpeg-libavcodec \
    git \
    supercronic \
    tzdata; \
    install-php-extensions \
    "@composer-${COMPOSER_VERSION}" \
    "apcu-${PHP_APCU_VERSION}" \
    exif \
    gd \
    gmp \
    "imagick-${PHP_IMAGICK_VERSION}" \
    intl \
    pcntl \
    pdo_mysql \
    pdo_pgsql \
    pgsql \
    phar \
    "redis-${PHP_REDIS_VERSION}" \
    sodium \
    sysvsem \
    zip; \
    mv "${PHP_INI_DIR}/php.ini-production" "${PHP_INI_DIR}/php.ini"; \
    test "$(php -r 'echo phpversion("apcu");')" = "${PHP_APCU_VERSION}"; \
    test "$(php -r 'echo phpversion("imagick");')" = "${PHP_IMAGICK_VERSION}"; \
    test "$(php -r 'echo phpversion("redis");')" = "${PHP_REDIS_VERSION}"; \
    test "$(composer --version --no-ansi | awk '{print $3}')" = "${COMPOSER_VERSION}"; \
    mkdir -p /usr/share/strukturpiloten; \
    { \
      printf 'php=%s\n' "$(php -r 'echo PHP_VERSION;')"; \
      printf 'composer=%s\n' "${COMPOSER_VERSION}"; \
      printf 'apcu=%s\n' "${PHP_APCU_VERSION}"; \
      printf 'imagick=%s\n' "${PHP_IMAGICK_VERSION}"; \
      printf 'redis=%s\n' "${PHP_REDIS_VERSION}"; \
      printf 'php_extension_installer_image=%s\n' "${PHP_EXTENSION_INSTALLER_IMAGE}"; \
    } > /usr/share/strukturpiloten/application-components.txt; \
    apk info -v | sort > /usr/share/strukturpiloten/apk-packages.txt; \
    rm -rf /var/cache/apk/*

ARG PODMAN_NEXTCLOUD_DATA_DIR_CONTAINER
RUN mkdir -p /opt/container-utilities/shell ${PODMAN_NEXTCLOUD_DATA_DIR_CONTAINER}
COPY --chmod=0755 shared/container-utilities/shell/check_variables_and_directories.sh /opt/container-utilities/shell/check_variables_and_directories.sh

WORKDIR ${PODMAN_NEXTCLOUD_DATA_DIR_CONTAINER}

ENV HOME=/home/www-data
RUN install -d -m 0777 /home/www-data

EXPOSE 9000

STOPSIGNAL SIGQUIT
