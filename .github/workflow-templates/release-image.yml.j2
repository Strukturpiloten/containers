# This file is generated by `python -m scripts.container_engine generate-workflow`.
# Do not edit image choices manually. Update image metadata and regenerate workflows instead.
name: Release image

on:
  workflow_dispatch:
    inputs:
      image:
        description: Image to release
        required: true
        type: choice
        options:
[% for image_name in image_names %]
          - [[ image_name ]]
[% endfor %]
      source-sha:
        description: Full commit SHA of the verified immutable image snapshot
        required: true
        type: string

concurrency:
  group: release-${{ inputs.image }}
  cancel-in-progress: false

permissions:
  contents: write
  packages: write

env:
  PYTHON_VERSION: "3.14"
  UV_VERSION: 0.12.5

jobs:
  release:
    name: Release ${{ inputs.image }}
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          ref: ${{ inputs.source-sha }}

      - name: Install uv
        uses: ./.github/actions/setup-uv
        with:
          version: ${{ env.UV_VERSION }}

      - name: Validate release source
        shell: bash
        env:
          DEFAULT_BRANCH: ${{ github.event.repository.default_branch }}
          SOURCE_SHA: ${{ inputs.source-sha }}
        run: |
          set -euo pipefail

          if [ "${GITHUB_REF_NAME}" != "${DEFAULT_BRANCH}" ]; then
            echo "Releases must run from ${DEFAULT_BRANCH}, not ${GITHUB_REF_NAME}." >&2
            exit 1
          fi

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine validate

          if ! printf '%s' "${SOURCE_SHA}" | grep -Eq '^[0-9a-f]{40}$'; then
            echo "source-sha must be a full lowercase Git commit SHA." >&2
            exit 1
          fi
          if [ "$(git rev-parse HEAD)" != "${SOURCE_SHA}" ]; then
            echo "Checked-out release source does not match ${SOURCE_SHA}." >&2
            exit 1
          fi
          if ! git merge-base --is-ancestor "${SOURCE_SHA}" "origin/${DEFAULT_BRANCH}"; then
            echo "Release source ${SOURCE_SHA} is not part of ${DEFAULT_BRANCH}." >&2
            exit 1
          fi

      - name: Resolve release metadata
        id: release_info
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine release-info \
            --image "${{ inputs.image }}"

      - name: Validate release target
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          IMAGE_NAME: ${{ inputs.image }}
          RELEASE_TAG: ${{ steps.release_info.outputs.release_tag }}
          SOURCE_SHA: ${{ inputs.source-sha }}
        run: |
          set -euo pipefail

          tag="${IMAGE_NAME}/${RELEASE_TAG}"
          if gh release view "${tag}" --repo "${GITHUB_REPOSITORY}" >/dev/null 2>&1; then
            echo "Release ${tag} already exists." >&2
            exit 1
          fi

          if git rev-parse --verify --quiet "refs/tags/${tag}^{commit}" >/dev/null; then
            tag_revision=$(git rev-list -n 1 "${tag}")
            if [ "${tag_revision}" != "${SOURCE_SHA}" ]; then
              echo "Git tag ${tag} already points to ${tag_revision}, not ${SOURCE_SHA}." >&2
              exit 1
            fi
          fi

      - name: Install OCI tooling
        shell: bash
        run: |
          set -euo pipefail

          sudo apt-get update
          sudo apt-get install --yes --no-install-recommends skopeo

      - name: Log in to GitHub Container Registry
        shell: bash
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail

          printf '%s' "${GITHUB_TOKEN}" | skopeo login --username "${GITHUB_ACTOR}" --password-stdin ghcr.io

      - name: Promote verified digest to SemVer tags
        id: release
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine release-image \
            --image "${{ inputs.image }}" \
            --source-sha "${{ inputs.source-sha }}" \
            --default-branch "${{ github.event.repository.default_branch }}"

      - name: Create GitHub release
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          IMAGE_NAME: ${{ steps.release.outputs.image_name }}
          SOURCE_SHA: ${{ inputs.source-sha }}
          VERSION: ${{ steps.release.outputs.version }}
        run: |
          set -euo pipefail

          tag="${IMAGE_NAME}/v${VERSION}"
          release_args=(
            --repo "${GITHUB_REPOSITORY}"
            --target "${SOURCE_SHA}"
            --generate-notes
            --title "${tag}"
          )

          if printf '%s' "${VERSION}" | grep -q '-'; then
            release_args+=(--prerelease)
          fi

          gh release create "${tag}" "${release_args[@]}"
