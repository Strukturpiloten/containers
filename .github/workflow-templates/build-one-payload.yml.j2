# Generated by `python -m scripts.container_engine generate-workflow`.
name: Build one shared payload

on:
  workflow_call:
    inputs:
      entry:
        required: true
        type: string

permissions: {}

env:
  PYTHON_VERSION: "<<( config.PYTHON_VERSION )>>"
  UV_VERSION: <<( config.UV_VERSION )>>

jobs:
  build:
    name: Build payload
    runs-on: ${{ fromJSON(inputs.entry).runner }}
    timeout-minutes: 60
    permissions:
      contents: read
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true
      - name: Install OCI tooling
        shell: bash
        run: |
          set -euo pipefail
          sudo apt-get update
          sudo apt-get install --yes --no-install-recommends buildah skopeo
      - name: Install uv
        uses: ./.github/actions/setup-uv
        with:
          version: ${{ env.UV_VERSION }}
      - name: Build verified payload archive
        shell: bash
        env:
          PAYLOAD_MANIFEST: ${{ fromJSON(inputs.entry).manifest }}
          PAYLOAD_ARCH: ${{ fromJSON(inputs.entry).arch }}
          SOURCE_REVISION: ${{ github.sha }}
        run: |
          set -euo pipefail
          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.build_payloads \
            --manifest "${PAYLOAD_MANIFEST}" --arch "${PAYLOAD_ARCH}" \
            --revision "${SOURCE_REVISION}" --output "${RUNNER_TEMP}/payload"
      - name: Upload payload and provenance
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: payload-${{ fromJSON(inputs.entry).name }}-${{ fromJSON(inputs.entry).arch }}
          path: ${{ runner.temp }}/payload/*
          if-no-files-found: error
          retention-days: 1
