# This file is generated by `python -m scripts.container_engine generate-workflow`.
# Do not edit stage jobs manually. Update image metadata or the template instead.
name: Publish images

on:
  push:
    branches:
      - main
    paths:
      - ".containerignore"
      - ".github/actions/**"
      - ".github/renovate.json"
      - ".github/workflow-templates/**"
      - ".github/workflows/publish-images.yml"
      - "container.schema.json"
      - "images/**"
      - "pyproject.toml"
      - "scripts/**"
      - "shared/**"
      - "tests/**"
      - "uv.lock"
  schedule:
    - cron: "47 3 * * *"
  workflow_dispatch:
    inputs:
      scope:
        description: Rebuild every image, one exact image, or one image family.
        required: true
        default: all
        type: choice
        options:
          - all
          - image
          - family
      target:
        description: Exact image or family name; leave empty when scope is all.
        required: false
        type: string

concurrency:
  group: publish-images-${{ github.ref }}
  cancel-in-progress: false

permissions: {}

env:
  PYTHON_VERSION: "3.14"
  SYFT_VERSION: v1.51.1
  UV_VERSION: 0.12.6

jobs:
  plan:
    name: Plan image builds
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
    outputs:
      has_builds: ${{ steps.outputs.outputs.has_builds }}
[% for stage in stages %]
      stage_[[ stage ]]_has_builds: ${{ steps.outputs.outputs.stage_[[ stage ]]_has_builds }}
      stage_[[ stage ]]_build_matrix: ${{ steps.outputs.outputs.stage_[[ stage ]]_build_matrix }}
      stage_[[ stage ]]_publish_matrix: ${{ steps.outputs.outputs.stage_[[ stage ]]_publish_matrix }}
[% endfor %]

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true

      - name: Install uv
        uses: ./.github/actions/setup-uv
        with:
          version: ${{ env.UV_VERSION }}

      - name: Check generated workflow
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine generate-workflow --check

      - name: Check Python formatting and linting
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" ruff format --check .
          uv run --frozen --python "${PYTHON_VERSION}" ruff check .

      - name: Run Python tests
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m unittest discover -s tests

      - name: Validate container metadata
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine validate

      - name: Validate version progression
        shell: bash
        env:
          BEFORE: ${{ github.event.before || '' }}
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine validate-versions \
            --before "${BEFORE}"

      - name: Create build plan
        shell: bash
        env:
          BEFORE: ${{ github.event.before || '' }}
          BUILD_SCOPE: ${{ inputs.scope || 'all' }}
          BUILD_TARGET: ${{ inputs.target || '' }}
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine plan \
            --event-name "${GITHUB_EVENT_NAME}" \
            --ref-name "${GITHUB_REF_NAME}" \
            --default-branch "${{ github.event.repository.default_branch }}" \
            --before "${BEFORE}" \
            --sha "${GITHUB_SHA}" \
            --scope "${BUILD_SCOPE}" \
            --target "${BUILD_TARGET}" \
            --output build-plan.json

      - name: Write workflow outputs
        id: outputs
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine github-outputs build-plan.json >> "$GITHUB_OUTPUT"

      - name: Summarize build plan
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine plan-summary build-plan.json >> "$GITHUB_STEP_SUMMARY"

      - name: Upload build plan
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: container-build-plan
          path: build-plan.json
          if-no-files-found: error
          retention-days: 1

[% for stage in stages %]
  build-stage-[[ stage ]]:
[% if single_stage %]
    name: Build ${{ matrix.name }} ${{ matrix.arch }}
[% else %]
    name: Build stage [[ stage ]] ${{ matrix.name }} ${{ matrix.arch }}
[% endif %]
[% if stage == 0 %]
    needs: plan
[% else %]
    needs:
      - plan
      - publish-stage-[[ stage - 1 ]]
[% endif %]
    if: needs.plan.outputs.stage_[[ stage ]]_has_builds == 'true'
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 120
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.plan.outputs.stage_[[ stage ]]_build_matrix) }}
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true
      - name: Build architecture image
        uses: ./.github/actions/build-arch-image
        with:
          entry: ${{ toJSON(matrix) }}

  publish-stage-[[ stage ]]:
[% if single_stage %]
    name: Publish ${{ matrix.name }}
[% else %]
    name: Publish stage [[ stage ]] ${{ matrix.name }}
[% endif %]
    needs:
      - plan
      - build-stage-[[ stage ]]
    if: needs.plan.outputs.stage_[[ stage ]]_has_builds == 'true'
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    permissions:
      attestations: write
      artifact-metadata: write
      contents: read
      id-token: write
      packages: write
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.plan.outputs.stage_[[ stage ]]_publish_matrix) }}
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true
      - name: Publish image
        uses: ./.github/actions/publish-image
        with:
          default-branch: ${{ github.event.repository.default_branch }}
          entry: ${{ toJSON(matrix) }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          syft-version: ${{ env.SYFT_VERSION }}

  finalize-stage-[[ stage ]]:
[% if single_stage %]
    name: Finalize release ${{ matrix.name }}
[% else %]
    name: Finalize stage [[ stage ]] release ${{ matrix.name }}
[% endif %]
    needs:
      - plan
      - publish-stage-[[ stage ]]
    if: >-
      needs.plan.outputs.stage_[[ stage ]]_has_builds == 'true' &&
      github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    permissions:
      contents: write
      packages: write
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.plan.outputs.stage_[[ stage ]]_publish_matrix) }}
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          fetch-tags: true
          persist-credentials: false
          submodules: true
      - name: Finalize release
        uses: ./.github/actions/finalize-release
        with:
          default-branch: ${{ github.event.repository.default_branch }}
          entry: ${{ toJSON(matrix) }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
[% endfor %]
