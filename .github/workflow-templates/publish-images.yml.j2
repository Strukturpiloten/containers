# This file is generated by `python -m scripts.container_engine generate-workflow`.
# Do not edit stage jobs manually. Update image metadata or the template instead.
name: Publish images

on:
  push:
    branches:
      - main
    paths:
      - ".containerignore"
      - ".github/automation.yml"
      - ".github/actions/**"
      - ".github/renovate.json"
      - ".github/workflow-templates/**"
      - ".github/workflows/publish-images.yml"
      - ".github/workflows/publish-one-image.yml"
      - ".github/workflows/build-one-payload.yml"
      - "container.schema.json"
      - "images/**"
      - "pyproject.toml"
      - "scripts/**"
      - "shared/**"
      - "tests/**"
      - "uv.lock"
  schedule:
    - cron: "47 3 * * *"
  workflow_dispatch:
    inputs:
      scope:
        description: Rebuild every image, one exact image, or one image family.
        required: true
        default: all
        type: choice
        options:
          - all
          - image
          - family
      target:
        description: Exact image or family name; leave empty when scope is all.
        required: false
        type: string

concurrency:
  group: publish-images-${{ github.ref }}
  cancel-in-progress: false

permissions: {}

env:
  ACTIONLINT_VERSION: <<( config.ACTIONLINT_VERSION )>>
  PYTHON_VERSION: "<<( config.PYTHON_VERSION )>>"
  SYFT_VERSION: <<( config.SYFT_VERSION )>>
  UV_VERSION: <<( config.UV_VERSION )>>

jobs:
  plan:
    name: Plan image builds
    runs-on: <<( config.AMD64_RUNNER )>>
    timeout-minutes: 15
    permissions:
      contents: read
    outputs:
      has_builds: ${{ steps.outputs.outputs.has_builds }}
      has_payloads: ${{ steps.outputs.outputs.has_payloads }}
      payload_matrix: ${{ steps.outputs.outputs.payload_matrix }}
[% for stage in stages %]
      stage_<<( stage )>>_has_builds: ${{ steps.outputs.outputs.stage_<<( stage )>>_has_builds }}
      stage_<<( stage )>>_build_matrix: ${{ steps.outputs.outputs.stage_<<( stage )>>_build_matrix }}
      stage_<<( stage )>>_publish_matrix: ${{ steps.outputs.outputs.stage_<<( stage )>>_publish_matrix }}
[% endfor %]

    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true

      - name: Install uv
        uses: ./.github/actions/setup-uv
        with:
          version: ${{ env.UV_VERSION }}

      - name: Validate GitHub workflow syntax
        uses: ./.github/actions/validate-workflows
        with:
          version: ${{ env.ACTIONLINT_VERSION }}

      - name: Check generated workflow
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.grype_pins
          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine generate-workflow --check
          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.maintenance --check \
            --json-output docs/image-catalogue.json --markdown-output docs/image-catalogue.md

      - name: Check Python formatting and linting
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" ruff format --check .
          uv run --frozen --python "${PYTHON_VERSION}" ruff check .

      - name: Run Python tests
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m unittest discover -s tests

      - name: Validate container metadata
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine validate

      - name: Validate version progression
        shell: bash
        env:
          BEFORE: ${{ github.event.before || '' }}
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine validate-versions \
            --before "${BEFORE}"

      - name: Create build plan
        shell: bash
        env:
          BEFORE: ${{ github.event.before || '' }}
          BUILD_SCOPE: ${{ inputs.scope || 'all' }}
          BUILD_TARGET: ${{ inputs.target || '' }}
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine plan \
            --event-name "${GITHUB_EVENT_NAME}" \
            --ref-name "${GITHUB_REF_NAME}" \
            --default-branch "${{ github.event.repository.default_branch }}" \
            --before "${BEFORE}" \
            --sha "${GITHUB_SHA}" \
            --scope "${BUILD_SCOPE}" \
            --target "${BUILD_TARGET}" \
            --output build-plan.json

      - name: Write workflow outputs
        id: outputs
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine github-outputs build-plan.json >> "$GITHUB_OUTPUT"

      - name: Summarize build plan
        shell: bash
        run: |
          set -euo pipefail

          uv run --frozen --python "${PYTHON_VERSION}" python -m scripts.container_engine plan-summary build-plan.json >> "$GITHUB_STEP_SUMMARY"

      - name: Upload build plan
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: container-build-plan
          path: build-plan.json
          if-no-files-found: error
          retention-days: 1

  payloads:
    name: Payload ${{ matrix.name }} ${{ matrix.arch }}
    needs: plan
    if: needs.plan.outputs.has_payloads == 'true'
    permissions:
      contents: read
    strategy:
      fail-fast: false
      max-parallel: 4
      matrix: ${{ fromJSON(needs.plan.outputs.payload_matrix) }}
    uses: ./.github/workflows/build-one-payload.yml
    with:
      entry: ${{ toJSON(matrix) }}

[% for stage in stages %]
  publish-stage-<<( stage )>>:
    name: Publish ${{ matrix.name }}
[% if stage == 0 %]
    needs: [plan, payloads]
[% else %]
    needs:
      - plan
      - publish-stage-<<( stage - 1 )>>
[% endif %]
    # A failed unrelated image must not block this stage. The builder requires
    # same-run results for selected dependencies and fails closed if missing.
    if: >-
      always() && !cancelled() && needs.plan.result == 'success' &&
      needs.plan.outputs.stage_<<( stage )>>_has_builds == 'true'
    permissions:
      attestations: write
      artifact-metadata: write
      contents: write
      id-token: write
      packages: write
    strategy:
      fail-fast: false
      max-parallel: 4
      matrix: ${{ fromJSON(needs.plan.outputs.stage_<<( stage )>>_publish_matrix) }}
    uses: ./.github/workflows/publish-one-image.yml
    with:
      entry: ${{ toJSON(matrix) }}
[% endfor %]
