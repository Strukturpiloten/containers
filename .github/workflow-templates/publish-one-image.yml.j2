# Generated by `python -m scripts.container_engine generate-workflow`.
name: Publish one image

on:
  workflow_call:
    inputs:
      entry:
        description: Image entry containing its architecture build matrix.
        required: true
        type: string

permissions: {}

env:
  PYTHON_VERSION: "<<( config.PYTHON_VERSION )>>"
  SYFT_VERSION: <<( config.SYFT_VERSION )>>
  UV_VERSION: <<( config.UV_VERSION )>>

jobs:
  build:
    name: Build ${{ matrix.arch }}
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 120
    permissions:
      contents: read
      packages: read
    strategy:
      fail-fast: false
      max-parallel: 2
      matrix: ${{ fromJSON(inputs.entry).buildMatrix }}
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true
      - name: Build architecture image
        uses: ./.github/actions/build-arch-image
        with:
          entry: ${{ toJSON(matrix) }}

  publish:
    name: Publish image
    needs: build
    runs-on: <<( config.AMD64_RUNNER )>>
    timeout-minutes: 90
    permissions:
      attestations: write
      artifact-metadata: write
      contents: read
      id-token: write
      packages: write
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false
          submodules: true
      - name: Publish image
        uses: ./.github/actions/publish-image
        with:
          default-branch: ${{ github.event.repository.default_branch }}
          entry: ${{ inputs.entry }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          syft-version: ${{ env.SYFT_VERSION }}

  finalize:
    name: Finalize release
    needs: publish
    if: github.ref_name == github.event.repository.default_branch
    runs-on: <<( config.AMD64_RUNNER )>>
    timeout-minutes: 45
    permissions:
      contents: write
      packages: write
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          fetch-tags: true
          persist-credentials: false
          submodules: true
      - name: Finalize release
        uses: ./.github/actions/finalize-release
        with:
          default-branch: ${{ github.event.repository.default_branch }}
          entry: ${{ inputs.entry }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
