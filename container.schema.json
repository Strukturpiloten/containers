{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Strukturpiloten/containers/blob/main/container.schema.json",
  "title": "Strukturpiloten container metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "image",
    "title",
    "description",
    "build",
    "dependencies",
    "inputs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "image": {
      "type": "string",
      "pattern": "^ghcr\\.io/strukturpiloten/[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "tests": {
      "$ref": "#/$defs/tests"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "imageReference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:/-]*@sha256:[a-f0-9]{64}$"
    },
    "buildArgument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "type"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "external-image",
            "internal-image",
            "static"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "external-image",
                  "internal-image"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/imageReference"
              }
            }
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "containerfile",
        "architectures",
        "runtimeBaseArg",
        "args"
      ],
      "properties": {
        "context": {
          "$ref": "#/$defs/relativePath"
        },
        "containerfile": {
          "$ref": "#/$defs/relativePath"
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "amd64",
              "arm64"
            ]
          }
        },
        "runtimeBaseArg": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "scheduled": {
          "type": "boolean"
        },
        "args": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/buildArgument"
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podman"
      ],
      "properties": {
        "podman": {
          "$ref": "#/$defs/podmanTest"
        }
      }
    },
    "podmanTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "outerPrivilege"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rootful",
            "rootless"
          ]
        },
        "outerPrivilege": {
          "enum": [
            "privileged",
            "unprivileged"
          ]
        },
        "nestedRuntime": {
          "type": "boolean"
        }
      }
    },
    "internalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "arg"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "arg": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "externalDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "arg"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*(?::[0-9]+)?(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)+$"
        },
        "arg": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "internal",
        "external"
      ],
      "properties": {
        "internal": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/internalDependency"
          }
        },
        "external": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/externalDependency"
          }
        }
      }
    }
  }
}
